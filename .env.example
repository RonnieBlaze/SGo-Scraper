# Copy this file to .env and fill in your cookies (see README: Cookie Acquisition).
# .env is git-ignored so your session cookies are never committed.

SESSIONIDTOKEN=
SGCSRFTOKEN=
RSCI_VID=
DOWNLOADSDIR=downloads
DOWNLOAD_DELAY_MS=2000
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/133.0.0.0 Safari/537.36"

# Optional settings (defaults shown)
# VIDEO_TIMEOUT_MIN=180
# LOGIN_CHECK=on
# COLOR=on
# SHOW_SKIPS=on
